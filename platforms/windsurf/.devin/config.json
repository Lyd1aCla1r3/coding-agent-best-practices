{
  "read_config_from": [
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "permissions": {
    "allow": [
      "Read(*)",
      "Exec(git status*)",
      "Exec(git diff*)",
      "Exec(python3 scripts/lint_prose.py*)",
      "Exec(bash scripts/plan.sh*)"
    ],
    "ask": [
      "Write(*)",
      "Exec(git commit*)",
      "Exec(git push*)"
    ],
    "deny": [
      "Read(.env*)",
      "Write(published/*)",
      "Write(archive/*)",
      "Exec(rm -rf *)"
    ]
  },
  "hooks": {
    "disable_all": false
  }
}
