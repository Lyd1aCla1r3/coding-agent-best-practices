{
  "model": "opusplan",
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(python3 scripts/lint_prose.py*)",
      "Bash(bash scripts/plan.sh*)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Write(./published/**)",
      "Write(./archive/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-freeze.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-destructive.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-network.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-secrets.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-freeze.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-secrets.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-style.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
